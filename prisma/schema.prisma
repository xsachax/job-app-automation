// Job Application Pipeline — data model
// SQLite for local-first dev; swap datasource to Postgres later without code changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A configurable job board source (Greenhouse, Lever, Ashby, GitHub repo, RSS, JSON...).
model Source {
  id           String        @id @default(cuid())
  name         String
  kind         String // greenhouse | lever | ashby | workable | github-repo | rss | json
  config       String        @default("{}") // JSON blob of adapter-specific config
  enabled      Boolean       @default(true)
  lastRunAt    DateTime?
  lastStatus   String? // ok | error
  lastMessage  String?
  lastJobCount Int           @default(0) // new jobs created on last run
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sightings    JobSighting[]
}

// A canonical, deduplicated job posting. One row per real-world job across all sources.
model Job {
  id          String        @id @default(cuid())
  dedupeKey   String        @unique // atsType:externalId, or fp:<hash>
  atsType     String        @default("unknown") // greenhouse | lever | ashby | workday | workable | unknown
  externalId  String?
  title       String
  company     String
  location    String?
  remote      Boolean       @default(false)
  applyUrl    String
  description String?
  postedAt    DateTime?
  isWorkday   Boolean       @default(false) // flagged, never auto-applied
  // --- Discovery pivot: entry-level SWE finder (see lib/discovery) ---
  country         String? // US | CA | OTHER — geography split for the two lists
  isEntryLevel    Boolean @default(false) // passed the entry-level/degree/YoE filter
  minYoE          Int? // smallest years-of-experience the posting requires, if any
  discoverySystem String? // greenhouse | ashby | amazon | uber | ... provenance
  fingerprint String? // sha1(company|title|country) — cross-source dedup key
  // --- Enrichment: structured, filterable facets extracted at ingest ---
  salaryMin      Int? // normalized annual minimum, when the posting states one
  salaryMax      Int? // normalized annual maximum
  salaryCurrency String? // USD | CAD
  salaryRaw      String? // original compensation string as shown
  sponsorship    String? // offers | none | citizenship | unknown (visa sponsorship)
  skills         String? // JSON array of normalized tech skills found in the posting
  employmentType String? // fulltime | intern | contract | unknown
  // --- User pipeline tracking (discovery link-out flow) ---
  applicationStatus String @default("none") // none | saved | applied | interviewing | offer | rejected | dismissed
  appliedAt         DateTime?
  // --- Post-scrape resume judge (see lib/judge) ---
  fitScore    Int? // 0..100 fit against the user's resume/qualifications
  fitReasons  String? // JSON array of short fit reasons
  fitSummary  String? // one-line fit/gap summary (mainly from the agent tier)
  fitProvider String? // deterministic | agent
  fitScoredAt DateTime?
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  raw         String? // raw source payload as JSON
  sightings   JobSighting[]
  match       Match?
  application Application?

  @@index([isWorkday])
  @@index([company])
  @@index([country])
  @@index([isEntryLevel])
  @@index([fingerprint])
  @@index([applicationStatus])
  @@index([fitScore])
}

// Records that a given source saw a given job (one job, many source sightings).
model JobSighting {
  id       String   @id @default(cuid())
  jobId    String
  sourceId String
  seenAt   DateTime @default(now())
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourceId])
}

// Fit assessment + pipeline status for a job we might apply to.
model Match {
  id        String   @id @default(cuid())
  jobId     String   @unique
  score     Int      @default(0) // Tier-1 deterministic rule score vs. criteria
  reasons   String? // JSON array of human-readable reasons
  // new | drafted | pending_approval | submitted | rejected | skipped | workday_flagged
  status    String   @default("new")
  // --- Tier-2 resume/skills fit (see lib/matching/resume.ts + agent.ts) ---
  resumeScore         Int? // 0..100 fit of this job against the resume
  resumeReasons       String? // JSON array of fit reasons
  resumeSummary       String? // short prose fit/gap summary (mainly from the agent)
  matchProvider       String? // deterministic | agent — who produced resumeScore
  scoredResumeVersion String? // ResumeVersion.id used, for staleness detection
  resumeScoredAt      DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
}

// A prepared application. UNIQUE on jobId is the hard "never apply twice" guard.
model Application {
  id          String    @id @default(cuid())
  jobId       String    @unique
  status      String    @default("drafted") // drafted | pending_approval | submitted | failed
  fields      String? // JSON snapshot of exactly what will be / was submitted
  submittedAt DateTime?
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// Singleton canonical profile (answers to typical application questions).
model Profile {
  id        String   @id @default("me")
  data      String   @default("{}") // JSON of all canonical answers
  updatedAt DateTime @updatedAt
}

// Singleton search criteria used for matching.
model Criteria {
  id        String   @id @default("default")
  data      String   @default("{}") // JSON: titles[], locations[], keywords[], excludeKeywords[], remoteOnly, seniority[]
  updatedAt DateTime @updatedAt
}

// Singleton, fully user-editable discovery configuration. Stored as a JSON blob
// (see lib/discovery/config.ts) so new knobs never require a migration — the
// whole point is that in two years the roles, locations, YoE ceiling, degree
// ceiling and enabled sources can all be changed from the dashboard without
// touching code.
model DiscoveryConfig {
  id        String   @id @default("default")
  data      String   @default("{}") // JSON DiscoveryConfigData
  updatedAt DateTime @updatedAt
}

// Resolved ATS backend for a Y Combinator company, cached so repeat discovery
// runs skip the (expensive) website crawl. `system`/`token` are null when no
// public Greenhouse/Lever/Ashby board could be found (negative result cached
// with a shorter TTL). Keyed by the company's YC directory slug.
model YcAtsCache {
  slug      String   @id
  name      String
  website   String?
  batch     String?
  system    String? // greenhouse | lever | ashby | null (none found)
  token     String?
  checkedAt DateTime @default(now())
}

// A parsed snapshot of the user's resume; drives "Refresh Profile".
model ResumeVersion {
  id        String   @id @default(cuid())
  source    String // local path or URL the resume was read from
  text      String // extracted plain text
  parsed    String   @default("{}") // structured fields JSON
  createdAt DateTime @default(now())
}
