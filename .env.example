# --- Database (required) ---
# Local-first SQLite. Swap for a Postgres URL later without code changes.
DATABASE_URL="file:./dev.db"

# --- Submission safety (optional) ---
# Master switch for actually sending applications.
#   dry_run (default) = prepare + record everything, submit NOTHING.
#   live              = attempt real submission (requires Playwright installed).
APPLY_MODE="dry_run"
# Per-ATS live auto-submit guards (only used when APPLY_MODE=live).
# GH_AUTO_SUBMIT="1"
# LEVER_AUTO_SUBMIT="1"

# --- Chrome extension listing (optional) ---
# Exact published listing used by the dashboard's Install extension button.
# When unset, the button opens the Chrome Web Store home page.
# NEXT_PUBLIC_CHROME_EXTENSION_STORE_URL="https://chromewebstore.google.com/detail/job-application-autofill/extension-id"

# --- Resume parsing (optional) ---
# If set, Refresh Profile uses OpenAI to parse your resume.
# If unset, a deterministic, dependency-free fallback parser is used.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Scheduled scanner (optional; used by `npm run cron`) ---
# Cron expression for how often to scan sources. Default: every 30 minutes.
SCAN_CRON="*/30 * * * *"
# Set to 0 to skip the immediate scan when the cron process starts.
SCAN_ON_START="1"
