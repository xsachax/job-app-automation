{
  "name": "job-app-automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "scan": "tsx scripts/scan.ts",
    "cron": "tsx scripts/cron.ts",
    "match:export": "tsx scripts/match.ts export",
    "match:apply": "tsx scripts/match.ts apply",
    "match:rescore": "tsx scripts/match.ts rescore",
    "judge": "tsx scripts/judge.ts",
    "judge:export": "tsx scripts/judge.ts export",
    "judge:apply": "tsx scripts/judge.ts apply",
    "e2e": "playwright test",
    "e2e:seed": "tsx scripts/e2e-seed.ts",
    "e2e:report": "playwright show-report",
    "sources:probe": "tsx scripts/probe-sources.ts",
    "discovery:verify": "tsx scripts/verify-queries.ts",
    "discover": "tsx scripts/discover.ts",
    "discover:browser": "tsx scripts/discover.ts --browser",
    "companies:dedupe": "tsx scripts/dedupe-companies.ts",
    "google-job:monitor": "tsx scripts/custom/google-job-monitor/cli.ts",
    "test:google-job-monitor": "vitest run --config scripts/custom/google-job-monitor/vitest.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fast-xml-parser": "^5.10.1",
    "next": "16.2.10",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
